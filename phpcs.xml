<?xml version="1.0"?>
<ruleset name="Management System">
  <file>src</file><file>tests</file><file>config</file><file>routes</file>
  <arg name="extensions" value="php"/><arg name="colors"/>
  <rule ref="PSR12">
    <exclude name="Generic.Files.LineLength.TooLong"/>
    <exclude name="Generic.Files.LineEndings.InvalidEOLChar"/>
  </rule>
</ruleset>

