{
  "name": "danjoli/sistema-gestao-php",
  "description": "Sistema administrativo em PHP puro com MVC, PDO e MySQL",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "ext-pdo": "*",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload": {
    "psr-4": {"App\\": "src/"}
  },
  "autoload-dev": {
    "psr-4": {"Tests\\": "tests/"}
  },
  "scripts": {
    "serve": "php -S localhost:8080 -t public",
    "migrate": "php bin/console migrate",
    "seed": "php bin/console seed",
    "test": "phpunit",
    "analyse": "phpstan analyse --memory-limit=512M",
    "cs": "phpcs",
    "check": ["@cs", "@analyse", "@test"]
  },
  "config": {"sort-packages": true, "allow-plugins": {}}
}

